{
  "name": "smritiflow",
  "version": "0.2.0",
  "description": "Repository-memory CLI for coding agents: generates AGENTS.md and docs/ai artifacts, with --json output and a session-start hook.",
  "type": "module",
  "license": "MIT",
  "author": "Subhajit Pradhan",
  "homepage": "https://github.com/subhajitlucky/smritiflow#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/subhajitlucky/smritiflow.git",
    "directory": "apps/cli"
  },
  "bugs": {
    "url": "https://github.com/subhajitlucky/smritiflow/issues"
  },
  "keywords": [
    "ai-agents",
    "agent-handoff",
    "repository-memory",
    "context-engineering",
    "codebase",
    "code-analysis",
    "developer-tools",
    "cli",
    "monorepo",
    "json-output"
  ],
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "smritiflow": "bin/smritiflow.js",
    "sf": "bin/smritiflow.js"
  },
  "files": [
    "bin",
    "dist"
  ],
  "devDependencies": {
    "esbuild": "^0.27.4"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "rm -rf dist && esbuild src/index.ts --bundle --platform=node --format=cjs --target=node20 --outfile=dist/index.cjs",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  }
}
