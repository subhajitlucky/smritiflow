{
  "name": "smritiflow",
  "private": true,
  "type": "module",
  "version": "0.2.0",
  "packageManager": "pnpm@10.32.1",
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm --filter ./apps/cli dev",
    "check": "tsx apps/cli/src/index.ts check",
    "lint": "pnpm typecheck",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "validate": "pnpm typecheck && pnpm test && pnpm build && pnpm check"
  },
  "devDependencies": {
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^25.9.9",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "commander": "^14.0.3",
    "fast-glob": "^3.3.3",
    "fs-extra": "^11.4.1",
    "ignore": "^7.0.12",
    "simple-git": "^3.36.0"
  }
}
